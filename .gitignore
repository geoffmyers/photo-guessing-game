# Dependencies
node_modules/

# Build output
dist/

# Electron build output (electron-builder)
release/

# Re-include this project's electron-builder resources, which the repo-root
# .gitignore would otherwise catch via its global `build/` rule.
!build/
!build/entitlements.mac.plist

# Local env files
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Photo files (user adds their own photos locally)
public/photos/*.jpg
public/photos/*.jpeg
public/photos/*.png
public/photos/*.heic
public/photos/*.heif
public/photos/*.tiff
public/photos/*.tif
public/photos/*.JPG
public/photos/*.JPEG
public/photos/*.PNG
public/photos/*.HEIC

# Generated manifest and cache (auto-generated on dev/build). The cache holds
# each photo's GPS position; it used to live in public/photos/.
public/photos/manifest.json
public/photos/.manifest-cache.json
/.manifest-cache.json
